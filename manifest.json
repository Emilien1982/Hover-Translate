{
  "manifest_version": 3,
  "name": "Hover Translate",
  "version": "0.1.0",
  "description": "Traduit le mot survolé : traduction courte en titre, entrée de dictionnaire contextuelle en dessous.",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["storage"],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*"
  ],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "Hover Translate — réglages" },
  "options_page": "src/options.html",
  "commands": {
    "toggle-hover": {
      "suggested_key": { "default": "Alt+Shift+T", "mac": "Alt+Shift+T" },
      "description": "Activer / désactiver la traduction au survol"
    }
  }
}
